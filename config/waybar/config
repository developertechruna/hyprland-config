// ==========================================
// Configuración de Waybar (Diseño de Islas Flotantes y Tipografía Dual)
// Ubicación original destino: ~/.config/waybar/config
// ==========================================
{
    "layer": "top",
        "position": "top",
            "height": 26,
                "spacing": 1,
                    "margin-top": 2,
                        "margin-bottom": 2,
                            "margin-left": 6,
                                "margin-right": 6,

                                    // Módulos organizados en 3 islas flotantes independientes
                                    //"modules-left": ["hyprland/workspaces", "wlr/taskbar", "hyprland/submap"],
                                    "modules-left": ["wlr/taskbar", "hyprland/submap"],
                                        "modules-center": ["clock"],
                                            "modules-right": [
                                                "cpu",
                                                "memory",
                                                "network",
                                                /*"custom/media",*/
                                                "custom/language",
                                                "pulseaudio",
                                                "custom/microphone",
                                                "battery",
                                                "tray",
                                                "custom/power"
                                            ],

                                                // Espacios de trabajo (Workspaces estilo píldoras activas)
                                                "hyprland/workspaces": {
        "disable-scroll": false,
            "all-outputs": true,
                "active-only": false,
                    "format": "{id}",
                        "persistent-workspaces": {
            "*": 6
        }
    },

    // Barra de tareas / aplicaciones abiertas
    "wlr/taskbar": {
        "format": "{icon}",
            "icon-size": 15,
                "icon-theme": "Tela-circle-dark",
                    "tooltip-format": "{title}",
                        "on-click": "activate",
                            "on-click-middle": "close",
                                "app_ids-mapping": {
            "firefoxdeveloperedition": "firefox-developer-edition"
        }
    },

    "hyprland/window": {
        "format": " {title} ",
            "max-length": 45,
                "separate-outputs": true
    },

    // Reloj central con fecha y hora completa
    "clock": {
        "format": "{:%a %b %d, %Y   %H:%M:%S}",
            "interval": 1,
                "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
    },

    // Estadísticas del sistema estilo pills (JetBrains Mono)
    "cpu": {
        "format": "CPU {usage}%",
            "tooltip": true,
                "interval": 2
    },

    "memory": {
        "format": "RAM {used:0.1f}GB/{total:0.1f}GB",
            "tooltip": true,
                "interval": 2
    },

    "network": {
        "format-wifi": "NET {signalStrength}%",
            "format-ethernet": "NET 100%",
                "format-disconnected": "NET 󰖪",
                    "tooltip-format": "{ifname} via {gwaddr}"
    },

    "custom/language": {
        "exec": "python3 ~/.config/hypr/get_layout.py",
            "interval": 1,
                "format": "{}",
                    "on-click": "python3 ~/.config/hypr/switch_layout.py",
                        "signal": 1
    },

    "pulseaudio": {
        "format": "VOL {volume}%",
            "format-muted": "VOL 󰝟",
                "on-click": "pavucontrol"
    },

    "custom/microphone": {
        "format": "{}",
        "return-type": "json",
        "exec": "bash ~/.config/waybar/mic.sh",
        "interval": 1,
        "signal": 11,
        "on-click": "bash ~/.config/hypr/toggle_mic.sh; pkill -RTMIN+11 waybar",
        "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SOURCE@ 5%+; pkill -RTMIN+11 waybar",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SOURCE@ 5%-; pkill -RTMIN+11 waybar",
        "tooltip": true
    },

    "battery": {
        "states": {
            "warning": 25,
            "critical": 15
        },
        "format": "{icon}",
        "format-charging": "󰂄",
        "format-plugged": "󰚥",
        "format-full": "󰁹",
        "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
        "tooltip": true,
        "tooltip-format": "Batería: {capacity}% ({timeTo})",
        "tooltip-format-charging": "Batería: {capacity}% (Cargando - {timeTo})",
        "tooltip-format-plugged": "Batería: {capacity}% (Conectado)"
    },

    /*"custom/media": {
        "format": "{}",
            "interval": 2,
                "return-type": "json",
                    "exec": "/home/johnny/.config/waybar/media.sh",
                        "on-click": "playerctl play-pause",
                            "on-scroll-up": "playerctl next",
                                "on-scroll-down": "playerctl previous",
                                    "signal": 10
    },*/

    "tray": {
        "icon-size": 14,
            "spacing": 8
    },

    "custom/power": {
        "format": "",
            "tooltip-format": "Menú de Apagado y Sesión",
                "on-click": "wlogout",
                    "interval": "once"
    }
}
