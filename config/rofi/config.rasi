/* Configuración de Rofi en Wayland - Estilo Spotlight Card */
/* Ubicación original destino: ~/.config/rofi/config.rasi */

configuration {
    modi: "drun,run,window";
    icon-theme: "WhiteSur-dark";
    show-icons: true;
    terminal: "xfce4-terminal";
    drun-display-format: "{name}";
    location: 0;
    disable-history: false;
    hide-scrollbar: true;
    display-drun: "";
    display-run: "";
    display-window: "";
    sidebar-mode: false;
}

@theme "/dev/null"

* {
    bg-col:             rgba(30, 30, 46, 0.90);
    bg-col-input:       rgba(49, 50, 68, 0.65);
    border-col:         rgba(255, 255, 255, 0.10);
    selected-col:       rgba(255, 255, 255, 0.08);
    blue:               #89b4fa;
    mauve:              #cba6f7;
    fg-col:             #cdd6f4;
    fg-muted:           #6c7086;
    fg-subtext:         #bac2de;

    font:               "Inter 10";
}

window {
    transparency:       "real";
    background-color:   @bg-col;
    text-color:         @fg-col;
    border:             1px solid;
    border-color:       @border-col;
    border-radius:      12px;
    width:              460px;
    padding:            6px;
    location:           center;
    anchor:             center;
}

mainbox {
    background-color:   transparent;
    children:           [ inputbar, listview ];
    spacing:            6px;
}

inputbar {
    background-color:   @bg-col-input;
    border-radius:      6px;
    padding:            6px 10px;
    children:           [ prompt, entry ];
    spacing:            8px;
}

prompt {
    background-color:   transparent;
    text-color:         @blue;
    font:               "JetBrainsMono Nerd Font Propo 11";
    padding:            0 2px 0 0;
    vertical-align:     0.5;
}

entry {
    background-color:   transparent;
    text-color:         @fg-col;
    placeholder:        "Search applications...";
    placeholder-color:  @fg-muted;
    vertical-align:     0.5;
    font:               "Inter 10";
}

listview {
    background-color:   transparent;
    columns:            1;
    lines:              6;
    spacing:            2px;
    cycle:              true;
    dynamic:            true;
    scrollbar:          false;
    layout:             vertical;
}

element {
    background-color:   transparent;
    text-color:         @fg-col;
    border-radius:      6px;
    padding:            4px 8px;
    spacing:            8px;
    orientation:        horizontal;
    children:           [ element-icon, element-text ];
}

element-icon {
    background-color:   transparent;
    size:               20px;
    vertical-align:     0.5;
}

element-text {
    background-color:   transparent;
    text-color:         inherit;
    vertical-align:     0.5;
    font:               "Inter 10";
}

element selected {
    background-color:   @selected-col;
    text-color:         #ffffff;
}

element selected element-text {
    text-color:         #ffffff;
}

error-message {
    padding:            10px;
    border-radius:      6px;
    background-color:   @bg-col;
    text-color:         #f38ba8;
}
