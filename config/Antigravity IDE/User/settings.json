{
    "workbench.colorTheme": "Solarized Dark",
    "python.languageServer": "Default",
    "editor.fontFamily": "'JetBrainsMono Nerd Font', 'JetBrains Mono', monospace",
    "editor.fontSize": 12,
    "editor.fontLigatures": true,
    "terminal.integrated.fontFamily": "'JetBrainsMono Nerd Font', monospace",
    "terminal.integrated.fontSize": 12,
    "markdown.preview.fontFamily": "'Inter', sans-serif",
    "chat.fontSize": 12,
    "chat.editor.fontSize": 12,
    "chat.fontFamily": "'Inter', sans-serif",
    "workbench.tree.indent": 14,
    "workbench.tree.renderIndentGuides": "always",
    "terminal.integrated.defaultProfile.linux": "zsh",
    "terminal.integrated.profiles.linux": {
        "zsh": {
            "path": "zsh",
            "icon": "terminal"
        },
        "zsh (JDK 8)": {
            "path": "zsh",
            "env": {
                "JAVA_HOME": "${userHome}/Apps/jdks/jdk1.8.0_461",
                "PATH": "${userHome}/Apps/jdks/jdk1.8.0_461/bin:${env:PATH}"
            },
            "icon": "coffee"
        },
        "zsh (JDK 7)": {
            "path": "zsh",
            "env": {
                "JAVA_HOME": "${userHome}/Apps/jdks/jdk1.7.0_80",
                "MAVEN_HOME": "${userHome}/Apps/apache-maven-3.2.5",
                "M2_HOME": "${userHome}/Apps/apache-maven-3.2.5",
                "PATH": "${userHome}/Apps/apache-maven-3.2.5/bin:${userHome}/Apps/jdks/jdk1.7.0_80/bin:${env:PATH}"
            },
            "icon": "coffee"
        },
        "zsh (JDK 6)": {
            "path": "zsh",
            "env": {
                "JAVA_HOME": "${userHome}/Apps/jdks/jdk1.6.0_45",
                "MAVEN_HOME": "${userHome}/Apps/apache-maven-3.2.5",
                "M2_HOME": "${userHome}/Apps/apache-maven-3.2.5",
                "PATH": "${userHome}/Apps/apache-maven-3.2.5/bin:${userHome}/Apps/jdks/jdk1.6.0_45/bin:${env:PATH}"
            },
            "icon": "coffee"
        },
        "bash": {
            "path": "bash",
            "icon": "terminal-bash"
        }
    },
    "java.configuration.runtimes": [
        {
            "name": "JavaSE-1.6",
            "path": "${userHome}/Apps/jdks/jdk1.6.0_45"
        },
        {
            "name": "JavaSE-1.7",
            "path": "${userHome}/Apps/jdks/jdk1.7.0_80"
        },
        {
            "name": "JavaSE-1.8",
            "path": "${userHome}/Apps/jdks/jdk1.8.0_461"
        }
    ]
}